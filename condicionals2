num1= input("Introdueix el primer número: ")
num2= input("Introdueix el segon número: ")

print('quina es la operació que vols fer?')
options = ["suma", "resta", "multiplicació", "divisió", "divisió entera", "mòdul", "potència"]
print("Les opcions són: " + str(options))
n1= int(num1)
n2= int(num2)

operation = input()

if operation == "suma":
    print('Quina suma vols fer, "n1 + n2" o "n2 + n1"?')
    choice = input()
    if choice == "n1 + n2":
        print("La suma és: " + str(n1 + n2))
    elif choice == "n2 + n1":
        print("La suma és: " + str(n2 + n1))

elif operation == "resta":
    print('Quina resta vols fer, "n1 - n2" o "n2 - n1"?')
    choice = input()
    if choice == "n1 - n2":
        print("La resta és: " + str(n1 - n2))
    elif choice == "n2 - n1":
        print("La resta és: " + str(n2 - n1))

elif operation == "multiplicació":
    print('Quina multiplicació vols fer, "n1 * n2" o "n2 * n1"?')
    choice = input()
    if choice == "n1 * n2":
        print("La multiplicació és: " + str(n1 * n2))
    elif choice == "n2 * n1":
        print("La multiplicació és: " + str(n2 * n1))

elif operation == "divisió":
    print('Quina divisió vols fer, "n1 / n2" o "n2 / n1"?')
    choice = input()
    if choice == "n1 / n2":
        print("La divisió és: " + str(n1 / n2))
    elif choice == "n2 / n1":
        print("La divisió és: " + str(n2 / n1))
    if n2 == 0:
        print("No es pot dividir per zero")

elif operation == "divisió entera":
    print('Quina divisió entera vols fer, "n1 // n2" o "n2 // n1"?')
    choice = input()
    if choice == "n1 // n2":
        print("La divisió entera és: " + str(n1 // n2))
    elif choice == "n2 // n1":
        print("La divisió entera és: " + str(n2 // n1))
    if n2 == 0:
        print("No es pot dividir per zero")

elif operation == "mòdul":
    print('Quin mòdul vols fer, "n1 % n2" o "n2 % n1"?')
    choice = input()
    if choice == "n1 % n2":
        print("El mòdul és: " + str(n1 % n2))
    elif choice == "n2 % n1":
        print("El mòdul és: " + str(n2 % n1))
    if n2 == 0:
        print("No es pot calcular el mòdul per zero")

elif operation == "potència":
    print('Quina potència vols fer, "n1 ** n2" o "n2 ** n1"?')
    choice = input()
    if choice == "n1 ** n2":
        print("La potència és: " + str(n1 ** n2))
    elif choice == "n2 ** n1":
        print("La potència és: " + str(n2 ** n1))
    if n2 < 0:
        print("No es pot calcular la potència amb exponent negatiu")
